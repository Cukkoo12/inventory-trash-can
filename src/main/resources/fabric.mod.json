	"authors": [
		"Cukkoo"
	],
	"license": "MIT",
	"icon": "assets/inventory_trash_can/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"com.cukkoo.inventorytrashcan.InventoryTrashCanMod"
		]
	},
	"mixins": [
		"inventory_trash_can.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.5",
